{
  "format": "gate-controller/easyeda-netlist-v1",
  "project": "Automatic-gate-ESP32",
  "board": "gate-power-io v1 (custom PCB, ESP32-S3-WROOM-1-N16R8)",
  "created": "2026-10-23",
  "source_doc": "SCHEMATIC.md + CT_WIRING.md",
  "usage": "Import into KiCad via tools/netlist_to_kicad.py -> .kicad_sch -> EasyEDA Pro import; or use parts[] LCSC codes to place manually in EasyEDA.",
  "power_tree": {
    "mains": ["L", "N", "PE"],
    "rails": [
      {"net": "+5V", "src": "HLK-PM10 (isolated AC-DC)", "load_a": 1.2},
      {"net": "+3V3", "src": "MP2482 synchronous buck from +5V", "load_a": 0.9},
      {"net": "VBAT", "src": "LiFePO4 1200mAh + BQ24074 charger (thermal interlock NTC)", "note": "UPS: save->log->telegram->sleep"},
      {"net": "GND", "type": "star", "note": "single point at C_BULK(100uF) on HLK output"}
    ]
  },
  "parts": [
    {"ref":"F1","value":"T5A/250V 5x20","lcsc":"C367985","desc":"fuse, mains input"},
    {"ref":"RV1","value":"S14K275E","lcsc":"C296715","desc":"MOV between L-N"},
    {"ref":"CX1","value":"0.1uF X2 275VAC","lcsc":"C158140","desc":"across L-N after F1"},
    {"ref":"LF1","value":"common-mode choke 10mH/0.5A","lcsc":"C2829971","desc":"EMI, before HLK"},
    {"ref":"PS1","value":"HLK-PM10 5V/2A","lcsc":"C2586024","desc":"isolated ac-dc module"},
    {"ref":"BD1","value":"BTA16-800CW x2","lcsc":"C107511","desc":"snubberless triacs OPEN/CLOSE gate via R_G 330R+R_GK 1k, A1->L_MOT"},
    {"ref":"OC1,OC2","value":"MOC3052 x2","lcsc":"C2549063","desc":"zero-cross optotriac drivers, LED side from GPIO via 330R"},
    {"ref":"OC3","value":"H11AA1","lcsc":"C175570","desc":"zero-cross detector -> GPIO1 (+100k pull, TVS)"},
    {"ref":"K1,K2,K3","value":"HF115F-L? 5V relay 16A x3","lcsc":"C254464","desc":"reversal changeover K1/K2 + shunt/lamp K3; flyback diodes 1N4148WS"},
    {"ref":"U1","value":"ULN2803A SOIC18","lcsc":"C24532","desc":"relay+buzzer driver, inputs from GPIO w/ 1k"},
    {"ref":"CT1","value":"ZMCT103C","lcsc":"C2829257","desc":"split-core CT, motor phase wire through window"},
    {"ref":"R_B1,R_B2","value":"22R 0.1% x2 bipolar burden","lcsc":"C25514","desc":"+-1.1V across ADC_IN, mid-rail ref"},
    {"ref":"D_Z1,D_Z2","value":"BZX84-C3V3 x2 anti-series","lcsc":"C11785","desc":"clamp ADC_IN to ~+-3.7V (protect, not rectify)"},
    {"ref":"R_FILT,C_FILT","value":"100R + 10nF NP0","lcsc":"C25104,C1663","desc":"antialias RC at ADC1_GPIO2"},
    {"ref":"R_V1,R_V2","value":"100k 0.1% x2 mid-rail divider","lcsc":"C117050","desc":"VREF=ADC/2 buffered by MCP6002 #1"},
    {"ref":"U_OP","value":"MCP6002-I/SN RRIO opamp","lcsc":"C75251","desc":"#1 VREF buffer, #2 precision clamp BAT_SENSE (0.4*VBAT)"},
    {"ref":"R_DIV1,R_DIV2","value":"100k/68k 0.1% BAT divider","lcsc":"C25878,C25900","desc":"VBAT -> U_OP#2 -> GPIO3(ADC1_CH4)"},
    {"ref":"Q_M","value":"AO3401 P-MOS SOT23","lcsc":"C15321","desc":"high-side battery switch, gate driven by Q_L AO3400 (C20918) from GPIO4, R_GS 100k"},
    {"ref":"NTC1","value":"10k NTC + 10k div","lcsc":"C177915","desc":"battery temp -> BQ24074 EN inhibit (<0C charge off)"},
    {"ref":"SUP1","value":"TPS3840DL29 + PMOS latch","lcsc":"C139453526","desc":"brownout <2.9V -> SHUTDOWN_N low + MAINS_DET event"},
    {"ref":"TVS_IN","value":"P6KE6.8CA x4 SMBJ6.8CA","lcsc":"C117172","desc":"on every external input (CSW,OSW,START,STOP,PHOTO,E-STOP)"},
    {"ref":"D_IN","value":"1N4148WS x8 series","lcsc":"C81309","desc":"series 1k+100n RC cell per input (legacy-safe, ESP32 tolerant)"},
    {"ref":"R_PU","value":"10k x8 pullups to +3V3","lcsc":"C25804","desc":"inputs active-low"},
    {"ref":"PCB1","value":"ESP32-S3-WROOM-1-N16R8","lcsc":"C2936377","desc":"main MCU; EN 10k+1uF; GPIO0/45/46 strap w/ 10k"},
    {"ref":"J_PROG","value":"USB-C","lcsc":"C2747879","desc":"UART0 flash+console, CC 5.1k x2, ESD USBLC6-2SC6 (C9388)"},
    {"ref":"ANT","value":"external u.FL 2.4GHz option","lcsc":"C145556","desc":"metal enclosure -> route antenna outside"},
    {"ref":"LED1..4","value":"green/red/yellow/blue 0805","lcsc":"C228580","desc":"PWR/STATE/VISION/NET via ULN2803A"},
    {"ref":"BZ1","value":"buzzer 5V","lcsc":"C94018","desc":"via ULN2803A + freewheel diode"},
    {"ref":"CAM1","value":"OV5640 DVP module","lcsc":"C2945462","desc":"2-lane MIPI->DVP adapter board; PWDN/RESET controllable for power budget"},
    {"ref":"IR1","value":"850nm IR LED array option","lcsc":"C2842757","desc":"driven by ULN2803A, only when camera awake & mains present"},
    {"ref":"C_BULK","value":"100uF/10V polymer + 4x10uF MLCC","lcsc":"C177966","desc":"+5V bulk (star ground point)"},
    {"ref":"C_UPS","value":"1F/5.5V hybrid cap x2","lcsc":"C449915","desc":"hold-up 2-5J for graceful shutdown steps 1-3"},
    {"ref":"CH1","value":"BQ24074 + INA219 I2C (optional)","lcsc":"C127750","desc":"charge mgmt, thermal pin, current telemetry"}
  ],
  "nets": [
    {"name":"L_MAIN","pins":["F1.2","RV1.1","CX1.1","LF1.1"]},
    {"name":"N_MAIN","pins":["F1.1","CX1.2","LF1.2","HLK.N","LAMP.N"]},
    {"name":"L_SW","pins":["LF1.3","HLK.L","K1.COM","TR_A1"]},
    {"name":"L_MOT","pins":["K1.NO","TR1.A1","TR2.A1","CT1.window-pass"]},
    {"name":"MOTOR_OPEN","pins":["TR1.A2","CON_MOTOR.1"]},
    {"name":"MOTOR_CLOSE","pins":["TR2.A2","CON_MOTOR.2"]},
    {"name":"CAP_RUN","pins":["CON_MOTOR.3","CON_MOTOR.4","(motor internal)"]},
    {"name":"SHUNT_K2","pins":["K2.NO","MOTOR_CLOSE"],"note":"close-open shunt contact"},
    {"name":"LAMP_L","pins":["K3.NO","CON_LAMP.1"]},
    {"name":"+5V","pins":["HLK.VOUT+","U1.VIN(MP2482).IN","K1.COIL","K2.COIL","K3.COIL","BZ1.+","C_BULK.1","C_UPS.1"]},
    {"name":"VBUS_5","pins":["USB.CCVBUS","SUP1.SENSE","Q_M.S","C_UPS.2"],"note":"diode-OR'd UPS rail into buck"},
    {"name":"+3V3","pins":["U1.OUT","PCB1.VDD","TVS/analog refs","R_PU top","CAM1.IOVDD"]},
    {"name":"VREF_ADC","pins":["R_V1/R_V2 mid","U_OP.1IN+","U_OP.1OUT","R_FILT.2"],"note":"~1.65V virtual ground, ONLY analog return"},
    {"name":"ADC_IN","pins":["CT1.sec.1","R_B1.1","D_Z1.A","R_FILT.1"],"note":"AC coupled +-1.1V around VREF via C_CPL 10uF NP0 to R_B2.2"},
    {"name":"ADC1_GPIO2","pins":["C_FILT.1","PCB1.GPIO2"],"note":"ESP32-S3 ADC1_CH2, one-pole 1.6MHz"},
    {"name":"BAT_SENSE","pins":["R_DIV1.1(VBAT)","R_DIV2.2(GND_ANA)","U_OP.2IN+","U_OP.2OUT","PCB1.GPIO3"],"gain":0.405},
    {"name":"MAINS_DET","pins":["OC3.OUT","R_PU.1","TVS_IN.1","PCB1.GPIO1"],"note":"half-sine pulses @2xfline, ext0 wake"},
    {"name":"TRIAC_OPEN","pins":["PCB1.GPIO5","R_LED.1","OC1.IN1","OC1.IN2->R_G->GATE TR1"],"note":"330R LED, 1k G-K"},
    {"name":"TRIAC_CLOSE","pins":["PCB1.GPIO6","...","OC2","TR2 gate"]},
    {"name":"RLY_DIR","pins":["PCB1.GPIO7","U_DRV.1","K1 coil","flyback 1N4148WS"]},
    {"name":"RLY_SHUNT","pins":["PCB1.GPIO8","U_DRV.2","K2 coil"]},
    {"name":"RLY_LAMP","pins":["PCB1.GPIO9","U_DRV.3","K3 coil"]},
    {"name":"ENC_A","pins":["CON_ENC.2","TVS_IN.2","R_PU.2","PCB1.GPIO10"],"note":"open-collector sensors, 10k PU 3V3, 100n debounce"},
    {"name":"ENC_B","pins":["CON_ENC.3","...","PCB1.GPIO11"]},
    {"name":"SW_CS","pins":["CON_IO.1","...","PCB1.GPIO12"]},
    {"name":"SW_OS","pins":["CON_IO.2","...","PCB1.GPIO13"]},
    {"name":"BTN_START","pins":["CON_IO.3","...","PCB1.GPIO14"]},
    {"name":"BTN_STOP","pins":["CON_IO.4","...","PCB1.GPIO15"]},
    {"name":"BUZZ","pins":["PCB1.GPIO16","U_DRV.4","BZ1-"]},
    {"name":"CAM_PWDN","pins":["PCB1.GPIO17","CAM1.PWDN"],"note":"camera off = battery mode default"},
    {"name":"CAM_RESET","pins":["PCB1.GPIO18","CAM1.RESET"]},
    {"name":"DVP","pins":["GPIO21..26 CAM_D0-D5","GPIO36..39 CAM_D6-D9","GPIO40 VSYNC","GPIO41 HREF","GPIO42 PCLK","GPIO48 XCLK","GPIO47 SCCB_SCL","GPIO20 SCCB_SDA"],"note":"8-bit DVP; verify vs strap pins on final layout"},
    {"name":"I2C","pins":["PCB1.GPIO45(SCA)","PCB1.GPIO46(SCL)","INA219","(OLED opt)"],"note":"strap pins -> keep 10k PU, no boot conflict if idle high"},
    {"name":"SHUTDOWN_N","pins":["SUP1.OUT","Q_L.G","Q_M.G via latch"],"note":"active-low brownout request"},
    {"name":"GND_PWR","pins":["HLK.VOUT-","K*.coil ret","TRIAC MT2","C_BULK.2"],"note":"star to GND at C_BULK.2"},
    {"name":"GND_ANA","pins":["VREF divider bot","R_B2.2","CT shield","U_OP.VSS"],"note":"separate pour, single-point join at C_BULK.2"},
    {"name":"GND_LOGIC","pins":["PCB1.GND","CAM1.GND","ULN ret","all input TVS cathodes"],"note":"pour joins at same star point"},
    {"name":"PE","pins":["RV1 case? NO -> PE to chassis, CON_PE, 1M+4.7nF Y-cap from mains mid"]}
  ],
  "safety_notes": [
    "Clearance L/GND >=6.4mm (reinforced), slot under OC1/OC2/OC3 and PS1.",
    "Trip-class fuse F1 co-located with MOV; trace widths 2.5mm tinned for L_MOT.",
    "Snubber shared: 33R+4.7nF NP0 630V across TR1 A1-A2 and TR2 A1-A2.",
    "Every external connector pin has series-R + TVS bidirectional to GND_LOGIC.",
    "Battery path fusable: 3A PTC before Q_M.",
    "Do NOT trust ZMCT103C saturation margin >30A: verify inrush with scope."
  ]
}
